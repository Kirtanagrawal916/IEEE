# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/herearn?schema=public"

# JWT Authentication
# Replace with a cryptographically secure random string in production
JWT_SECRET="herearn-secure-jwt-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Security & CORS (Frontend URL)
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
