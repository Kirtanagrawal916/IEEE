// HerEarn Database Schema - Prisma ORM Definition
// Database: PostgreSQL / MySQL / SQLite

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  LEARNER
  EMPLOYER
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GigType {
  MICRO_GIG
  REMOTE_INTERNSHIP
  FREELANCE
  FULL_TIME
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

/// User model representing learners, employers, and administrators
model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                Role                 @default(LEARNER)
  avatar              String?
  phone               String?
  location            String?
  bio                 String?
  skills              String[]             @default([])
  totalEarned         Float                @default(0.0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  enrollments         Enrollment[]
  portfolios          PortfolioProject[]
  postedOpportunities Opportunity[]        @relation("PostedOpportunities")
  applications        Application[]
  transactions        PaymentTransaction[]

  @@map("users")
}

/// Skill Track model representing curated learning paths
model SkillTrack {
  id          String      @id @default(uuid())
  title       String
  category    String
  icon        String
  duration    String
  level       CourseLevel @default(BEGINNER)
  instructor  String
  description String
  image       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("skill_tracks")
}

/// Individual video lesson inside a SkillTrack
model Lesson {
  id           String     @id @default(uuid())
  trackId      String
  track        SkillTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title        String
  duration     String
  videoUrl     String
  summary      String
  keyTakeaways String[]   @default([])
  orderIndex   Int        @default(0)

  @@map("lessons")
}

/// Enrollment tracking user progress in a course
model Enrollment {
  id                 String     @id @default(uuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId            String
  track              SkillTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  completedLessonIds String[]   @default([])
  progressPercent    Float      @default(0.0)
  isCompleted        Boolean    @default(false)
  completedAt        DateTime?
  lastAccessedAt     DateTime   @default(now())
  createdAt          DateTime   @default(now())

  @@unique([userId, trackId])
  @@map("enrollments")
}

/// User showcase portfolio project
model PortfolioProject {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String
  description String
  imageUrl    String
  projectUrl  String?
  tags        String[] @default([])
  likesCount  Int      @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("portfolio_projects")
}

/// Opportunity board gig or internship posting
model Opportunity {
  id              String        @id @default(uuid())
  postedById      String
  postedBy        User          @relation("PostedOpportunities", fields: [postedById], references: [id], onDelete: Cascade)
  title           String
  company         String
  logo            String?
  stipend         String
  type            GigType       @default(MICRO_GIG)
  category        String
  skillsRequired  String[]      @default([])
  duration        String
  description     String
  deliverables    String[]      @default([])
  verifiedClient  Boolean       @default(true)
  isOpen          Boolean       @default(true)
  applicantsCount Int           @default(0)
  deadline        DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  applications    Application[]

  @@map("opportunities")
}

/// Learner application submitted to an opportunity
model Application {
  id                  String            @id @default(uuid())
  opportunityId       String
  opportunity         Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverNote           String
  portfolioProjectIds String[]          @default([])
  status              ApplicationStatus @default(SUBMITTED)
  appliedAt           DateTime          @default(now())

  @@unique([opportunityId, userId])
  @@map("applications")
}

/// Financial income & transaction tracking
model PaymentTransaction {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId   String?
  amount          Float
  currency        String            @default("INR")
  type            String            @default("GIG_PAYOUT")
  status          TransactionStatus @default(COMPLETED)
  transactionDate DateTime          @default(now())

  @@map("payment_transactions")
}
