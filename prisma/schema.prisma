// HerEarn Backend - Prisma Schema Specification

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  name             String
  username         String?            @unique
  email            String             @unique
  passwordHash     String
  role             String             @default("LEARNER") // LEARNER, EMPLOYER, ADMIN
  avatar           String?
  phone            String?
  location         String?
  bio              String?
  title            String?            @default("Digital Skill Specialist")
  skills           String             @default("[]") // JSON string of skill array
  skillPoints      Int                @default(150)
  totalEarned      Float              @default(0.0)
  earnings         Float              @default(0.0)
  walletBalance    Float              @default(0.0)
  completedLessons String             @default("[]") // JSON string of completed lesson IDs
  appliedGigIds    String             @default("[]") // JSON string of applied gig IDs
  bookmarkedGigIds String             @default("[]") // JSON string of bookmarked gig IDs
  solvedPuzzles    String             @default("[]") // JSON string of solved puzzle IDs
  badges           String             @default("[]") // JSON string of badge titles
  status           String             @default("Active") // Active, Suspended
  verifiedKyc      Boolean            @default(false)
  verified         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  enrollments  Enrollment[]
  progress     LessonProgress[]
  portfolios   PortfolioProject[]
  applications Application[]

  postedOpportunities Opportunity[] @relation("PostedOpportunities")
  @@index([email])
  @@index([username])
}

model SkillTrack {
  id          String       @id @default(uuid())
  title       String
  category    String
  icon        String
  duration    String
  level       String       @default("Beginner")
  instructor  String
  description String
  image       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([category])
}

model Lesson {
  id           String           @id @default(uuid())
  trackId      String
  track        SkillTrack       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title        String
  duration     String
  videoUrl     String
  summary      String
  keyTakeaways String           @default("[]") // JSON string of takeaways
  orderIndex   Int              @default(0)

  progress     LessonProgress[]

  @@index([trackId])
}

model Enrollment {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId         String
  track           SkillTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  progressPercent Float      @default(0.0)
  isCompleted     Boolean    @default(false)
  completedAt     DateTime?
  lastAccessedAt  DateTime   @default(now())
  createdAt       DateTime   @default(now())

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model PortfolioProject {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  category            String
  description         String
  imageUrl            String
  projectUrl          String?
  tags                String               @default("[]") // JSON string of tags
  likesCount          Int                  @default(0)
  verified            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  applicationProjects ApplicationProject[]

  @@index([userId])
}

model Opportunity {
  id              String        @id @default(uuid())
  title           String
  company         String
  logo            String?
  stipend         String
  type            String        @default("Micro-Gig")
  category        String
  skillsRequired  String        @default("[]") // JSON string of required skills
  duration        String
  description     String
  deliverables    String        @default("[]") // JSON string of deliverables
  verifiedClient  Boolean       @default(true)
  isOpen          Boolean       @default(true)
  status          String        @default("verified") // verified, pending, flagged
  applicantsCount Int           @default(0)
  deadline        DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  postedById String?
  postedBy   User?   @relation("PostedOpportunities", fields: [postedById], references: [id], onDelete: SetNull)
  applications    Application[]

  @@index([category])
}

model Application {
  id                  String               @id @default(uuid())
  opportunityId       String
  opportunity         Opportunity          @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverNote           String
  status              String               @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, SHORTLISTED, ACCEPTED, REJECTED
  appliedAt           DateTime             @default(now())

  applicationProjects ApplicationProject[]

  @@unique([opportunityId, userId])
  @@index([userId])
  @@index([opportunityId])
}

model ApplicationProject {
  id            String           @id @default(uuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  projectId     String
  project       PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([applicationId, projectId])
  @@index([applicationId])
  @@index([projectId])
}

model EscrowTransaction {
  id             String   @id @default(uuid())
  code           String   @unique
  gigTitle       String
  clientName     String
  freelancerName String
  amount         Float
  status         String   @default("HELD_IN_ESCROW") // HELD_IN_ESCROW, DISBURSED, DISPUTED_FROZEN
  freelancerId   String?
  opportunityId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  detail    String
  type      String   @default("info") // security, escrow, approval, warning, delete, user
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
