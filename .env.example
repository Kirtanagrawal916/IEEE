# Frontend & Backend Environment Variables Specification (Production-Ready)

# Backend API URL (leave empty in local development if using Vite proxy)
VITE_API_URL=""

# Supabase Authentication Configuration (Frontend - Safe for Browser)
# Project URL & Anon/Publishable API Key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Supabase Authentication Configuration (Backend Only - NEVER expose to browser)
# Project URL & Secret / Service Role Key for server-side token validation
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-service-role-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Database Configuration (SQLite dev or PostgreSQL production)
DATABASE_URL="file:./dev.db"

# Google OAuth 2.0 Web Client Credentials
# Configure in Google Cloud Console -> Credentials, and add to Supabase Auth -> Providers -> Google
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# JWT Authentication (Internal platform tokens fallback)
JWT_SECRET="your-secure-jwt-signing-secret"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,https://herearn.vercel.app"

# Optional: Master Admin Key for Platform Admin Verification
ADMIN_SECRET_KEY="HEREARN-ADMIN-2026-X9K"
