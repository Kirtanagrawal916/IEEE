# Frontend & Backend Environment Variables Specification (Production-Ready)
# Copy this file to .env and fill in real values before running the project.

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Backend API URL (leave empty in local development – Vite proxy handles /api/*)
VITE_API_URL=""

# Supabase Frontend – Project URL & Anon/Publishable API Key
# (Safe for browser: get from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Google OAuth (frontend)
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# ── Backend (Server – NEVER expose these to the browser) ─────────────────────
# Supabase Backend – Secret / Service Role Key for server-side token validation
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-service-role-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Google OAuth (backend verification)
# Configure in Google Cloud Console -> Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Database
# SQLite (default for local dev with server/):
DATABASE_URL="file:./dev.db"
# PostgreSQL (for backend/ service – uncomment and fill in for production):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT Authentication (internal platform tokens)
# Replace with a cryptographically secure random string in production
JWT_SECRET="your-secure-jwt-signing-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS (comma-separated allowed origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,https://herearn.vercel.app"

# Optional: Master Admin Key for Platform Admin Verification
ADMIN_SECRET_KEY="HEREARN-ADMIN-2026-X9K"

# AI Chatbot (Earn Assistant)
# Get a free Gemini API key at https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
