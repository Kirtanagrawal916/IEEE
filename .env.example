# Frontend Environment Variables
# HerEarn Backend API URL (leave empty in development if using Vite proxy, or specify http://localhost:5000)
VITE_API_URL=""

# Google OAuth 2.0 / Google Identity Services Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins must include: http://localhost:5173 (and your production Vercel/domain URL)
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
