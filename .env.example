# HerEarn Platform – Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit your real .env file to version control.

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# API base URL for frontend requests:
# - In local development: use empty string (requests go to Vite dev server / proxy)
# - In production: set to your deployed backend URL, e.g. https://api.herearn.org
VITE_API_URL=""

# Google OAuth Client ID for frontend sign-in button
# Create at https://console.cloud.google.com/apis/credentials
# Must be authorized for JavaScript origins: http://localhost:5173, https://your-domain.vercel.app
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Supabase Auth
# Create project at https://supabase.com/dashboard
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# ---------------------------------------------------------------------------
# Backend (Express API)
# ---------------------------------------------------------------------------
# Supabase Backend Service Role (bypasses RLS for secure admin operations)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-service-role-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Google OAuth (backend verification)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Database
# SQLite (default for local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (for Supabase / Render production):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# JWT Authentication (internal platform tokens)
JWT_SECRET="your-secure-jwt-signing-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin Panel Access Key
ADMIN_SECRET_KEY="your-admin-secret-key-here"


# AI Chatbot (Earn Assistant - Google Gemini)
# Get a free Gemini API key at https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
